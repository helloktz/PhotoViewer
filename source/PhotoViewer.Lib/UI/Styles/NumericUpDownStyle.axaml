<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coll="using:System.Collections"
    xmlns:types="using:PhotoViewer.Common.Types">

    <Style Selector="NumericUpDown">
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <ButtonSpinner
                        Name="PART_Spinner"
                        MinWidth="0"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        AllowSpin="{TemplateBinding AllowSpin}"
                        Background="Transparent"
                        BorderThickness="0"
                        ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                        IsTabStop="False"
                        ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}">
                        <TextBox
                            Name="PART_TextBox"
                            MinWidth="0"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AcceptsReturn="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Foreground="{TemplateBinding Foreground}"
                            InnerLeftContent="{CompiledBinding InnerLeftContent, RelativeSource={RelativeSource TemplatedParent}}"
                            InnerRightContent="{CompiledBinding InnerRightContent, RelativeSource={RelativeSource TemplatedParent}}"
                            IsReadOnly="{TemplateBinding IsReadOnly}"
                            PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                            PlaceholderText="{TemplateBinding PlaceholderText}"
                            Text="{TemplateBinding Text}"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextWrapping="NoWrap" />
                    </ButtonSpinner>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ DataValidationErrors">
            <Setter Property="ErrorTemplate">
                <DataTemplate x:DataType="coll:IEnumerable">
                    <ItemsControl Foreground="{DynamicResource IG_TextDangerBrush}" ItemsSource="{CompiledBinding}">
                        <ItemsControl.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="FontSize" Value="{x:Static types:Const.FONT_SIZE_SMALL}" />
                            </Style>
                        </ItemsControl.Styles>
                    </ItemsControl>
                </DataTemplate>
            </Setter>
        </Style>

    </Style>

</Styles>
