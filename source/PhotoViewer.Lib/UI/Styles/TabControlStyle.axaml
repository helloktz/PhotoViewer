<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:types="using:PhotoViewer.Common.Types">

    <Styles.Resources>
        <Thickness x:Key="PhTabHeaderPadding">0</Thickness>
    </Styles.Resources>

    <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
        <Setter Property="Margin" Value="{DynamicResource PhTabHeaderPadding}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="FontSize" Value="{x:Static types:Const.FONT_SIZE_SUBTITLE}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <Style Selector="TabItem:selected, TabItem:pointerover, TabItem:pressed, TabItem:selected:pointerover, TabItem:selected:pressed">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

</Styles>
