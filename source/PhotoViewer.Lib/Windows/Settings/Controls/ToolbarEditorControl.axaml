<ui:PhControl
    x:Class="PhotoViewer.Common.Windows.ToolbarEditorControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PhotoViewer.UI"
    mc:Ignorable="d"
    d:DesignWidth="760"
    HorizontalAlignment="Stretch">

    <ui:PhControl.Styles>
        <Style Selector="Border.zone">
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource IG_BackgroundNeutralBrush}" />
        </Style>

        <Style Selector="Rectangle.zoneDash">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="RadiusX" Value="6" />
            <Setter Property="RadiusY" Value="6" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="4,3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource ZoneGrayStroke}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    <BrushTransition Property="Stroke" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Rectangle.zoneDash.valid">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Rectangle.zoneDash.hover">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="0.95" />
            <Setter Property="Stroke" Value="{DynamicResource ZoneAccentBorder}" />
        </Style>
        <Style Selector="Rectangle.zoneDash.danger">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="0.95" />
            <Setter Property="Stroke" Value="{DynamicResource IG_TextDangerBrush}" />
        </Style>

        <Style Selector="Border.dropMarker">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ZoneAccentBorder}" />
        </Style>

    </ui:PhControl.Styles>

    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1500" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Spacing="10">

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:PhButton x:Name="PART_AddCustomBtn" Variant="Default" />
                <ui:PhButton x:Name="PART_ResetBtn" Variant="Link" />
            </StackPanel>

            <ui:PhTextBlock
                MaxWidth="{StaticResource TextContentMaxWidth}"
                HorizontalAlignment="Left"
                LangKey="Settings_Toolbar_ArrangeHint"
                Opacity="0.7"
                TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <ui:PhTextBlock FontWeight="SemiBold" LangKey="Settings_Toolbar_CurrentButtons" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.5*" />
                        <ColumnDefinition
                            Width="1.5*"
                            MinWidth="100"
                            MaxWidth="300" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border x:Name="PART_PrimaryZone" Classes="zone">
                            <WrapPanel x:Name="PART_PrimaryGroup" />
                        </Border>
                        <Rectangle x:Name="PART_PrimaryDash" Classes="zoneDash" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <Border x:Name="PART_SecondaryZone" Classes="zone">
                            <WrapPanel x:Name="PART_SecondaryGroup" />
                        </Border>
                        <Rectangle x:Name="PART_SecondaryDash" Classes="zoneDash" />
                    </Grid>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <ui:PhTextBlock FontWeight="SemiBold" LangKey="Settings_Toolbar_AvailableButtons" />
                <Grid>
                    <Border x:Name="PART_AvailableZone" Classes="zone">
                        <WrapPanel x:Name="PART_AvailableGroup" />
                    </Border>
                    <Rectangle x:Name="PART_AvailableDash" Classes="zoneDash" />
                </Grid>
            </StackPanel>

        </StackPanel>

        <Canvas x:Name="PART_DragLayer" IsHitTestVisible="False" />
    </Grid>

</ui:PhControl>
