<ui:PhControl
    x:Class="PhotoViewer.Common.Windows.EditAppWindowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PhotoViewer.UI"
    mc:Ignorable="d"
    d:DesignWidth="480">

    <StackPanel Orientation="Vertical" Spacing="14">

        <StackPanel Spacing="5">
            <ui:PhTextBlock LangKey="_FileExtension" />
            <ui:PhTextBox x:Name="PART_Extension" IsRequired="True" PlaceholderText=".jpg;.png;.svg" />
        </StackPanel>

        <StackPanel Spacing="5">
            <ui:PhTextBlock LangKey="Settings_EditApps_AppName" />
            <ui:PhTextBox x:Name="PART_AppName" IsRequired="True" PlaceholderText="{OnPlatform 'My Editor',                                              Windows='MS Paint',                                              x:TypeArguments=x:String}" />
        </StackPanel>

        <ui:PhActionEditorControl x:Name="PART_Action" ArgumentPlaceholder="&lt;file&gt;" ExecutablePlaceholder="{OnPlatform '/path/to/editor',                                                Windows='mspaint.exe',                                                macOS='/Applications/MyEditor.app',                                                x:TypeArguments=x:String}" ShowHotkeys="False" />

    </StackPanel>
</ui:PhControl>
