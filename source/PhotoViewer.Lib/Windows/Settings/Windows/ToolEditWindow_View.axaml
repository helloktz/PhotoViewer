<ui:PhControl
    x:Class="PhotoViewer.Common.Windows.ToolEditWindowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PhotoViewer.UI"
    mc:Ignorable="d"
    d:DesignWidth="480">

    <StackPanel Orientation="Vertical" Spacing="14">

        <StackPanel Spacing="5">
            <ui:PhTextBlock LangKey="_ID" />
            <ui:PhTextBox
                x:Name="PART_Id"
                IsRequired="True"
                PlaceholderText="Tool_MyTool" />
        </StackPanel>

        <StackPanel Spacing="5">
            <ui:PhTextBlock LangKey="_Name" />
            <ui:PhTextBox x:Name="PART_Name" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="PART_Integrated">
                <ui:PhTextBlock x:Name="PART_IntegratedBefore" TextWrapping="Wrap" />
            </CheckBox>
            <ui:PhTextBlock
                x:Name="PART_IntegratedAfter"
                VerticalAlignment="Center"
                IsVisible="False" />
        </StackPanel>

        <ui:PhActionEditorControl
            x:Name="PART_Action"
            ArgumentPlaceholder="&lt;file&gt;"
            ExecutablePlaceholder="{OnPlatform '/path/to/tool',
                                               Windows='C:\\path\\to\\tool.exe',
                                               macOS='/Applications/MyTool.app',
                                               x:TypeArguments=x:String}" />

    </StackPanel>
</ui:PhControl>
