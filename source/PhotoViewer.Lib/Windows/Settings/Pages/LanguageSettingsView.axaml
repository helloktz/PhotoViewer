<windows:SettingsPageView
    x:Class="PhotoViewer.Common.Windows.LanguageSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:PhotoViewer.Common.Localization"
    xmlns:types="using:PhotoViewer.Common.Types"
    xmlns:ui="using:PhotoViewer.UI"
    xmlns:windows="using:PhotoViewer.Common.Windows"
    mc:Ignorable="d"
    d:DesignWidth="600"
    HorizontalAlignment="Stretch">

    <StackPanel Orientation="Vertical">

        <StackPanel Margin="{DynamicResource SettingsGroupIndent}" Spacing="14">

            <StackPanel Spacing="{DynamicResource SettingsLabelInputGap}">
                <ui:PhTextBlock LangKey="Settings_DisplayLanguage" />

                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        x:Name="PART_LanguageList"
                        Width="350"
                        VerticalAlignment="Top">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="loc:Lang">
                                <StackPanel Width="300" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{CompiledBinding Metadata.LocalName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            IsVisible="{CompiledBinding !IsBuiltIn}"
                                            Opacity="0.6"
                                            Text="{CompiledBinding Metadata.EnglishName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock
                                        FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                                        IsVisible="{CompiledBinding !IsBuiltIn}"
                                        Opacity="0.6"
                                        Text="{CompiledBinding DisplayFilePath}"
                                        TextTrimming="PathSegmentEllipsis"
                                        ToolTip.Tip="{CompiledBinding DisplayFilePath}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:PhButton
                        x:Name="PART_RefreshLanguages"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Margin="0,14,0,0"
                HorizontalAlignment="Left"
                Spacing="8">
                <ui:PhButton x:Name="PART_ExportLanguage" Variant="Link" />
            </StackPanel>

        </StackPanel>

    </StackPanel>

</windows:SettingsPageView>
