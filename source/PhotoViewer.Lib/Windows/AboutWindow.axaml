<uiw:DialogWindow
    x:Class="PhotoViewer.Common.Windows.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:types="using:PhotoViewer.Common.Types"
    xmlns:ui="using:PhotoViewer.UI"
    xmlns:uiw="using:PhotoViewer.UI.Windowing"
    mc:Ignorable="d"
    d:DesignWidth="500">

    <uiw:DialogWindow.DialogContent>
        <StackPanel
            VerticalAlignment="Top"
            Orientation="Vertical"
            Spacing="4">

            <Panel x:Name="PART_Hero" Background="Transparent">

                <StackPanel Orientation="Vertical" Spacing="4">
                    <ui:PhLogo
                        x:Name="PART_Logo"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        LogoSize="96" />

                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource IG_TextAccentColor}"
                        Text="Photo Viewer" />

                    <TextBlock
                        x:Name="PART_LblSlogan"
                        HorizontalAlignment="Center"
                        FontSize="{x:Static types:Const.FONT_SIZE_SUBTITLE}"
                        TextAlignment="Center" />
                </StackPanel>
            </Panel>

            <SelectableTextBlock
                x:Name="PART_LblVersion"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                TextAlignment="Center" />

            <Border
                Height="1"
                Margin="0,16,0,12"
                Background="{DynamicResource IG_BorderNeutralBrush}" />

            <SelectableTextBlock
                x:Name="PART_LblCopyright"
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                TextAlignment="Center" />

            <Border
                Height="1"
                Margin="0,16"
                Background="{DynamicResource IG_BorderNeutralBrush}" />

            <TextBlock
                x:Name="PART_LblCredits"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                TextAlignment="Center" />

            <Border ClipToBounds="True" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ScrollViewer
                    MaxHeight="100"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock
                        x:Name="PART_LblCreditContent"
                        Padding="6"
                        Background="{DynamicResource IG_BackgroundNeutralBrush}"
                        FontFamily="{x:Static types:Const.FONT_CODE}"
                        FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                        FontWeight="SemiLight"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </uiw:DialogWindow.DialogContent>

</uiw:DialogWindow>
