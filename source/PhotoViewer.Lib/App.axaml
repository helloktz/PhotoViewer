<Application
    x:Class="PhotoViewer.Common.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoViewer.UI"
    Name="Photo Viewer"
    RequestedThemeVariant="Default">

    <!--  macOS application menu  -->


    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/ButtonStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/ComboBoxStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/TextBoxStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/NumericUpDownStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/CheckBoxStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/RadioButtonStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/ToggleSwitchStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/MenuStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/ListBoxItemStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/TabControlStyle.axaml" />
        <StyleInclude Source="avares://PhotoViewer.Lib/UI/Styles/ControlStyle.axaml" />

    </Application.Styles>



    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/CommonResources.axaml" />
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/ToggleSwitchResources.axaml" />
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/IconResources.axaml" />
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/ScrollBarResources.axaml" />
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/MenuResources.axaml" />
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/ComboBoxResources.axaml" />
                <ResourceInclude Source="avares://PhotoViewer.Lib/UI/Styles/SliderStyle.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>