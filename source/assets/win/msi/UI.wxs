<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include Variables.wxi ?>

  <Fragment>
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)assets\banner.png" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)assets\dialog.png" />

    <UI Id="IgWixUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="14" />
      <TextStyle Id="WixUI_Font_Title"  FaceName="Segoe UI" Size="10" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="CancelDlg" />
      <DialogRef Id="WaitForCostingDlg" />
      <DialogRef Id="OutOfDiskDlg" />
      <DialogRef Id="OutOfRbDiskDlg" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="VerifyReadyDlg" />

      <Dialog Id="IgInstallDirDlg" Width="370" Height="270" Title="!(loc.IgDlgTitle)" TrackDiskSpace="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.IgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="240" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}!(loc.IgFolderTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.IgFolderDescription)" />

        <Control Id="FolderLabel" Type="Text" X="20" Y="81" Width="330" Height="14"
                 Text="!(loc.IgFolderLabel)" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="97" Width="266" Height="18"
                 Sunken="yes" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="Browse" Type="PushButton" X="292" Y="97" Width="56" Height="17"
                 Text="!(loc.IgBrowse)">
          <Publish Property="IGBROWSEFOLDER" Value="[INSTALLFOLDER]" Order="1" />
          <Publish Event="SpawnDialog" Value="IgBrowseFolderDlg" Order="2" />
        </Control>

        <Control Id="ReplaceNote" Type="Text" X="20" Y="124" Width="330" Height="20"
                 Text="!(loc.IgReplaceNote)"
                 ShowCondition="WIX_UPGRADE_DETECTED" HideCondition="NOT WIX_UPGRADE_DETECTED" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="212" Y="243" Width="80" Height="17" Default="yes"
                 Text="!(loc.VerifyReadyDlgInstall)">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="DoAction" Value="WixUIValidatePath_$(var.WixUiArch)" Order="2" />
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3"
                   Condition="WIXUI_INSTALLDIR_VALID &lt;&gt; &quot;1&quot;" />
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="4"
                   Condition="WIXUI_INSTALLDIR_VALID = &quot;1&quot; AND OutOfDiskSpace = 1" />
          <Publish Event="EndDialog" Value="Return" Order="5"
                   Condition="WIXUI_INSTALLDIR_VALID = &quot;1&quot; AND OutOfDiskSpace &lt;&gt; 1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="IgBrowseFolderDlg" Width="370" Height="270" Title="!(loc.BrowseDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.IgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="240" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.IgBrowseFolderTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.IgBrowseFolderDescription)" />
        <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10"
                 Text="!(loc.BrowseDlgComboLabel)" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="247" Height="80"
                 Property="IGBROWSEFOLDER" Fixed="yes" Remote="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="325" Y="55" Width="19" Height="19"
                 ToolTip="!(loc.BrowseDlgWixUI_Bmp_UpTooltip)" Icon="yes" FixedSize="yes" IconSize="16"
                 Text="!(loc.BrowseDlgWixUI_Bmp_Up)">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="98"
                 Property="IGBROWSEFOLDER" Sunken="yes" />
        <Control Id="PathLabel" Type="Text" X="25" Y="190" Width="320" Height="10"
                 Text="!(loc.BrowseDlgPathLabel)" />
        <Control Id="PathEdit" Type="PathEdit" X="25" Y="202" Width="320" Height="18"
                 Property="IGBROWSEFOLDER" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUIOK)">
          <Publish Event="SetTargetPath" Value="IGBROWSEFOLDER" Order="1" />
          <Publish Property="INSTALLFOLDER" Value="[IGBROWSEFOLDER]" Order="2"
                   Condition="IGBROWSEFOLDER ~&gt;&gt; &quot;\$(var.IgFolderName)\&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[IGBROWSEFOLDER]$(var.IgFolderName)\" Order="3"
                   Condition="NOT (IGBROWSEFOLDER ~&gt;&gt; &quot;\$(var.IgFolderName)\&quot;)" />
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="4" />
          <Publish Event="EndDialog" Value="Return" Order="5" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog"
               Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog"
               Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog"
               Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog"
               Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="MaintenanceTypeDlg" Condition="Installed AND NOT PATCH" />

      <Dialog Id="IgCompleteDlg" Width="370" Height="270" Title="!(loc.IgDlgTitle)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234"
                 TabSkip="no" Disabled="yes" Text="!(loc.IgDialogBitmap)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="50"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}!(loc.IgCompleteTitle)" />
        <Control Id="Description" Type="Text" X="135" Y="76" Width="220" Height="30"
                 Transparent="yes" NoPrefix="yes" Text="!(loc.IgCompleteDescription)" />

        <Control Id="InfoIcon" Type="Icon" X="135" Y="108" Width="24" Height="24"
                 TabSkip="yes" FixedSize="no" IconSize="48" Text="!(loc.IgInfoIcon)"
                 ShowCondition="NOT Installed" HideCondition="Installed" />

        <Control Id="LaunchCheckBox" Type="CheckBox" X="135" Y="196" Width="220" Height="18"
                 Property="IGLAUNCHAFTERINSTALL" CheckBoxValue="1"
                 Text="!(loc.IgLaunchAfterInstall)"
                 ShowCondition="NOT Installed" HideCondition="Installed" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.IgFinish)">
          <Publish Event="DoAction" Value="IgLaunchApp" Order="1"
                   Condition="IGLAUNCHAFTERINSTALL = &quot;1&quot; AND NOT Installed" />
          <Publish Event="EndDialog" Value="Return" Order="999" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Disabled="yes" Text="!(loc.WixUICancel)" />
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />

    <InstallUISequence>
      <Show Dialog="IgInstallDirDlg" Before="ProgressDlg" Condition="NOT Installed" />
      <Show Dialog="IgCompleteDlg" OnExit="success" />
    </InstallUISequence>

    <AdminUISequence>
      <Show Dialog="IgCompleteDlg" OnExit="success" />
    </AdminUISequence>

    <SetProperty Id="IgLaunchTarget" Value="[#FileImageGlassExe]"
                 After="ExecuteAction" Sequence="ui" />
    <CustomAction Id="IgLaunchApp" Property="IgLaunchTarget" ExeCommand=""
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
  </Fragment>
</Wix>
